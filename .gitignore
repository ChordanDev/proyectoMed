# proyectoMed root ignore rules.
#
# Per-subdirectory `.gitignore` files in `web/` and `backend/` cover
# most generator output. The entries below mirror the runtime-scaffold
# spec requirement and provide a defensive belt-and-braces set so root-
# level inspection never accidentally picks up generated state.

# Existing planning state (kept from initial scaffold).
.atl/

# Local editor and code-navigation state.
.DS_Store
.codegraph/

# ---------------------------------------------------------------------------
# Web (Vite) — generated dependencies, caches, and build output
# ---------------------------------------------------------------------------

node_modules/
dist/
.vite/
.vitest/
*.local

# TypeScript build info.
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Backend (Phoenix / Elixir) — defensive mirrors of backend/.gitignore
# ---------------------------------------------------------------------------

# Compiled BEAM and artifacts.
_build/
*.beam

# Dependencies and docs.
deps/
doc/

# Coverage, fetched deps, archives.
cover/
.fetch
*.ez
backend-*.tar

# Crash dumps.
erl_crash.dump

# Temporary test output.
/tmp/

# Elixir tooling caches.
.elixir_ls/
.exenv/
.iex/
.mix/
priv/plts/
*.plt
*.plt.hash

# Generated static assets (mirrors priv/static/assets).
priv/static/assets/

# Erlang build tooling.
.rebar3/
_ebin/

# Local secrets. Keep example files tracked.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Unreal Engine project (unreal/) — engine-generated artefacts
# ---------------------------------------------------------------------------

# Compiled binaries and intermediate build state, regenerated by the editor
# or by UnrealBuildTool.
unreal/Binaries/
unreal/Intermediate/
unreal/Plugins/**/Binaries/
unreal/Plugins/**/Intermediate/

# Editor caches, logs, autosaves, crash reports, and local config overrides.
unreal/Saved/
unreal/DerivedDataCache/

# Build/ holds generated packaging state, except each platform's Resources/
# (Info.Template.plist, entitlements, icons), which belong to the project.
unreal/Build/**
!unreal/Build/*/
!unreal/Build/*/Resources/
!unreal/Build/*/Resources/**

# Packaged builds and staging output.
unreal/Packaged/
unreal/Archive/

# Generated IDE project files (regenerate from the .uproject).
unreal/*.sln
unreal/*.xcworkspace/
unreal/*.code-workspace
unreal/.vs/
unreal/.vscode/
unreal/.idea/
unreal/*.VC.db
unreal/*.opensdf
unreal/*.sdf
unreal/*.suo

# Built lighting data, rebuilt from the map.
unreal/**/*_BuiltData.uasset
