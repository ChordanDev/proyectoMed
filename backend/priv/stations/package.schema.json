{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proyectomed.dev/schemas/station-package/2.0.0",
  "title": "Station Package",
  "description": "The versioned content contract supplied by a Content Partner.",
  "type": "object",
  "required": [
    "station_id",
    "version",
    "language",
    "display_title",
    "placeholder",
    "patient_profile",
    "revealable_facts",
    "response_rules",
    "expected_actions",
    "rubric"
  ],
  "properties": {
    "station_id": {"type": "string", "minLength": 1},
    "version": {"const": "2.0.0"},
    "language": {"const": "pt-BR"},
    "display_title": {"type": "string", "minLength": 1},
    "placeholder": {"type": "boolean"},
    "patient_profile": {
      "type": "object",
      "required": ["persona", "age", "presenting_context", "tone"],
      "properties": {
        "persona": {"type": "string", "minLength": 1},
        "age": {"type": "integer", "minimum": 0},
        "presenting_context": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "minLength": 1}
      }
    },
    "revealable_facts": {"$ref": "#/$defs/revealableFacts"},
    "response_rules": {"$ref": "#/$defs/responseRules"},
    "expected_actions": {"$ref": "#/$defs/expectedActions"},
    "rubric": {"$ref": "#/$defs/rubric"},
    "approved_templates": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"$ref": "#/$defs/approvedTemplate"}}
      ]
    },
    "impressos": {
      "oneOf": [
        {"$ref": "#/$defs/impressos"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "revealableFacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/revealableFact"}
    },
    "revealableFact": {
      "type": "object",
      "required": ["id", "topic", "content", "disclosure_condition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "disclosure_condition": {
          "enum": ["on_request", "after_action", "timed", "unconditional"]
        }
      }
    },
    "responseRules": {
      "type": "array",
      "items": {"$ref": "#/$defs/responseRule"}
    },
    "responseRule": {
      "type": "object",
      "required": ["id", "instruction"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1}
      }
    },
    "expectedActions": {
      "type": "array",
      "items": {"$ref": "#/$defs/expectedAction"}
    },
    "expectedAction": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "rubric": {
      "description": "A rubric has at most one task_order criterion, and one that has it needs at least two other criteria with a non-null order. The task_order criterion is assessed in code from those ranks and is never sent to the classifier.",
      "type": "array",
      "items": {"$ref": "#/$defs/rubricCriterion"},
      "if": {
        "contains": {
          "required": ["rule"],
          "properties": {"rule": {"const": "task_order"}}
        }
      },
      "then": {
        "contains": {
          "required": ["rule"],
          "properties": {"rule": {"const": "task_order"}}
        },
        "maxContains": 1,
        "allOf": [
          {
            "contains": {
              "required": ["order"],
              "properties": {"order": {"type": "integer"}}
            },
            "minContains": 2
          }
        ]
      }
    },
    "rubricCriterion": {
      "description": "Cross-field rules enforced by the loader: action ids are unique within a criterion; thresholds (levels[].min_actions) do not decrease as points increase; the highest threshold is reachable, so it is at most the number of actions whose role is not forbidden, at most count_cap when count_cap is set and at most first_n when first_n is set; first_n limits scoring to the learner's first N answers to the criterion, including answers that match no authored action, and has no effect on a criterion without actions; a criterion with thresholds, a mandatory action or a forbidden action has a zero-point level. A task_order criterion authors no actions and no thresholds, sets order, count_cap, first_n and modality_requirement to null and veto to false, and has a zero-point level; the loader reports each violation with its own message.",
      "type": "object",
      "required": [
        "id",
        "description",
        "evidence_questions",
        "practice_recommendation",
        "levels",
        "actions",
        "order",
        "count_cap",
        "first_n",
        "veto",
        "exclusion",
        "modality_requirement"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "practice_recommendation": {"type": "string", "minLength": 1},
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rubricLevel"},
          "description": "Thresholds are all-or-none: every level sets min_actions or no level does.",
          "anyOf": [
            {"items": {"required": ["min_actions"]}},
            {"items": {"not": {"required": ["min_actions"]}}}
          ]
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/rubricAction"}
        },
        "order": {"type": ["integer", "null"]},
        "count_cap": {"type": ["integer", "null"], "minimum": 1},
        "first_n": {"type": ["integer", "null"], "minimum": 1},
        "veto": {"type": "boolean", "default": false},
        "exclusion": {"type": "boolean", "default": false},
        "modality_requirement": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "rule": {"enum": [null, "task_order"], "default": null}
      },
      "if": {
        "required": ["actions"],
        "properties": {
          "actions": {
            "contains": {
              "required": ["role"],
              "properties": {"role": {"const": "forbidden"}}
            }
          }
        }
      },
      "then": {
        "properties": {"veto": {"const": true}}
      },
      "allOf": [
        {
          "if": {
            "required": ["rule"],
            "properties": {"rule": {"const": "task_order"}}
          },
          "then": {
            "properties": {
              "levels": {
                "contains": {"properties": {"points": {"const": 0}}},
                "items": {"not": {"required": ["min_actions"]}}
              },
              "actions": {"maxItems": 0},
              "order": {"type": "null"},
              "count_cap": {"type": "null"},
              "first_n": {"type": "null"},
              "veto": {"const": false},
              "modality_requirement": {"type": "null"}
            }
          }
        }
      ]
    },
    "rubricLevel": {
      "type": "object",
      "required": ["label", "points", "description"],
      "properties": {
        "label": {
          "enum": ["inadequado", "parcialmente_adequado", "adequado"]
        },
        "points": {"type": "number", "multipleOf": 0.125},
        "min_actions": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "required": ["points", "min_actions"],
            "properties": {"points": {"const": 0}}
          },
          "then": {
            "properties": {"min_actions": {"const": 0}}
          }
        },
        {
          "if": {
            "required": ["points", "min_actions"],
            "properties": {"points": {"exclusiveMinimum": 0}}
          },
          "then": {
            "properties": {"min_actions": {"minimum": 1}}
          }
        }
      ]
    },
    "rubricAction": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "role": {"enum": ["counted", "mandatory", "forbidden"], "default": "counted"}
      }
    },
    "approvedTemplate": {
      "type": "object",
      "required": ["template_id", "text", "applicability"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "applicability": {"$ref": "#/$defs/applicabilityPredicate"}
      }
    },
    "applicabilityPredicate": {
      "description": "Structured, machine-evaluable applicability predicate (issue #147). Prose strings are not part of the contract.",
      "oneOf": [
        {"$ref": "#/$defs/unconditionalPredicate"},
        {"$ref": "#/$defs/firstLearnerTurnPredicate"},
        {"$ref": "#/$defs/minLearnerTurnsPredicate"},
        {"$ref": "#/$defs/maxLearnerTurnsPredicate"}
      ]
    },
    "unconditionalPredicate": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "unconditional"}
      }
    },
    "firstLearnerTurnPredicate": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "first_learner_turn"}
      }
    },
    "minLearnerTurnsPredicate": {
      "type": "object",
      "required": ["type", "count"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "min_learner_turns"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "maxLearnerTurnsPredicate": {
      "type": "object",
      "required": ["type", "count"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "max_learner_turns"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "impressos": {
      "type": "array",
      "items": {"$ref": "#/$defs/impresso"}
    },
    "impresso": {
      "type": "object",
      "required": ["id", "title", "category", "keywords", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "category": {
          "type": "string",
          "enum": ["physical_exam", "laboratory", "imaging", "report"]
        },
        "keywords": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "content": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "object", "minProperties": 1}
          ]
        }
      }
    }
  }
}
