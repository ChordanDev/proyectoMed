{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proyectomed.dev/schemas/station-package/1.0.0",
  "title": "Station Package",
  "description": "The versioned content contract supplied by a Content Partner.",
  "type": "object",
  "required": [
    "station_id",
    "version",
    "language",
    "display_title",
    "patient_profile",
    "revealable_facts",
    "response_rules",
    "expected_actions",
    "rubric"
  ],
  "properties": {
    "station_id": {"type": "string", "minLength": 1},
    "version": {"const": "1.0.0"},
    "language": {"const": "pt-BR"},
    "display_title": {"type": "string", "minLength": 1},
    "patient_profile": {
      "type": "object",
      "required": ["summary"],
      "properties": {"summary": {"type": "string", "minLength": 1}}
    },
    "revealable_facts": {"$ref": "#/$defs/revealableFacts"},
    "response_rules": {"$ref": "#/$defs/responseRules"},
    "expected_actions": {"$ref": "#/$defs/expectedActions"},
    "rubric": {"$ref": "#/$defs/rubric"}
  },
  "$defs": {
    "revealableFacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/revealableFact"}
    },
    "revealableFact": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "responseRules": {
      "type": "array",
      "items": {"$ref": "#/$defs/responseRule"}
    },
    "responseRule": {
      "type": "object",
      "required": ["id", "instruction"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1}
      }
    },
    "expectedActions": {
      "type": "array",
      "items": {"$ref": "#/$defs/expectedAction"}
    },
    "expectedAction": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "rubric": {
      "type": "array",
      "items": {"$ref": "#/$defs/rubricCriterion"}
    },
    "rubricCriterion": {
      "type": "object",
      "required": ["id", "description", "evidence_questions", "practice_recommendation", "weight"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "practice_recommendation": {"type": "string", "minLength": 1},
        "weight": {"type": "number"}
      }
    }
  }
}
