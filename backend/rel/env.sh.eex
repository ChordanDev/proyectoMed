#!/bin/sh
# Release environment (#344).
#
# Erlang distribution is bound to the loopback interface: `bin/backend rpc`
# (and `bin/drain`) reach the running node only from inside the same machine,
# for example through `fly ssh console`, and never over the network. The node
# does not cluster with other machines: conversations are local to each node.
export RELEASE_DISTRIBUTION="name"
export RELEASE_NODE="<%= @release.name %>@127.0.0.1"
export ERL_EPMD_ADDRESS="127.0.0.1"
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface {127,0,0,1}"
