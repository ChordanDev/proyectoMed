#!/bin/sh
# Provisions an admin from ADMIN_EMAIL and ADMIN_PASSWORD (#331, #344).
# Idempotent; never prints the password; exits 1 when no admin results.
# See docs/operations/deploy.md.
set -eu

cd -P -- "$(dirname -- "$0")"
exec ./backend eval "Backend.Release.create_admin() |> Backend.Release.exit_code() |> System.halt()"
