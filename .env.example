# Copy to .env and fill in. Load with: set -a; source .env; set +a
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Patient speech (voice-worker only; never sent to the browser).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Default: eleven_flash_v2_5 (low latency, supports pt-BR).
ELEVENLABS_MODEL=eleven_flash_v2_5
# Shared secret between Phoenix and voice-worker; generate with: openssl rand -hex 32
VOICE_WORKER_SECRET=
PHOENIX_URL=http://localhost:4000
