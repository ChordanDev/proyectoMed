# Names only: copy to .env (never committed), fill in and load with
#   set -a; source .env; set +a
# See "Real-time voice demo runbook" in README.md for each value.

# --- Phoenix (backend) ---
# realtime | turn | off. Unset: realtime when the three LIVEKIT_* are set, else turn.
VOICE_MODE=
# Local dev server: ws://127.0.0.1:7880 with devkey / secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret between Phoenix and voice-worker; generate with: openssl rand -hex 32
VOICE_WORKER_SECRET=
# anthropic, or unset for OpenAI.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# typesafe: Jev verifies every patient reply.
JEV_ADAPTER=
TYPESAFE_API_KEY=
# Optional: on.
RUBRIC_RESOLVER=
# Optional, e.g. acute-appendicitis.
ACTIVE_STATION_ID=
# Learner transcription: Phoenix in turn mode and the voice-worker in realtime mode.
DEEPGRAM_API_KEY=

# --- Phoenix turn mode (VOICE_MODE=turn) ---
# deepgram_cartesia (uses CARTESIA_* below), or unset for OpenAI speech.
VOICE_PROVIDER=

# --- voice-worker (also uses LIVEKIT_*, VOICE_WORKER_SECRET and DEEPGRAM_API_KEY above) ---
# Phoenix base URL, e.g. http://localhost:4000.
PHOENIX_URL=
# Patient speech (voice-worker, and Phoenix with VOICE_PROVIDER=deepgram_cartesia;
# never sent to the browser).
CARTESIA_API_KEY=
# A Cartesia voice that speaks Portuguese: the default voice.
CARTESIA_VOICE_ID=
# Optional, companion stations (#341): voice-key=voice-id,... for the keys infantil,
# masculina-adulta, feminina-adulta, masculina-idosa and feminina-idosa.
CARTESIA_VOICE_IDS=
# Optional. Default: sonic-3 (low latency, supports Portuguese).
CARTESIA_MODEL=
# Optional (uncomment to override; a blank value logs a warning). Defaults: 35 s, 1 retry.
# PHOENIX_TURN_TIMEOUT_S=
# PHOENIX_TURN_RETRIES=
