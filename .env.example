# Copy to .env and fill in. Load with: set -a; source .env; set +a
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Shared secret between Phoenix and voice-worker; generate with: openssl rand -hex 32
VOICE_WORKER_SECRET=
PHOENIX_URL=http://localhost:4000
